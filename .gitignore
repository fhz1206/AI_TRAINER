# 虚拟环境
venv/
.venv/

# Python 缓存
__pycache__/
*.pyc
*.pyo

# IDE 配置
.idea/
.vscode/
*.swp

# 大体积生成文件（训练得到的模型权重）
*.pth
*.pt
*.h5

# 运行时产物：日志 / 数据库 / 用户数据 / 打包输出
logs/
*.log
*.db
uploads/
test_data/
output/
# models/ 双重身份：既是模型代码包（跟踪 *.py），也是训练产物目录（忽略其余）
/models/*
!/models/*.py
*.atomcode/
.gitignore
instance/
# 临时资源
tokenizer/*.json
